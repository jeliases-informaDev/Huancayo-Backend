# Caja Huancayo - Auditoria de Visitas (Backend)
# Plantilla de PRODUCCION (Render + MySQL administrado en Aiven).
# No se sube un .env real: estos valores se pegan en Render > Environment.
# El Blueprint (render.yaml) ya declara casi todas estas variables; las marcadas
# como "sync: false" en render.yaml son las que hay que completar a mano aqui.

# --- Aiven MySQL ---
# En Aiven: Services > (tu servicio MySQL) > Overview > "Connection information".
# Formato: mysql://usuario:password@host:puerto/nombre_bd
# Aiven exige TLS, por eso tambien hace falta DATABASE_SSL_CA.
DATABASE_URL=mysql://avnadmin:xxxxx@mysql-xxxx.aivencloud.com:12345/defaultdb

# Aiven: Services > (tu servicio) > Overview > "CA certificate" (boton "Download").
# Pegar el contenido COMPLETO del archivo ca.pem tal cual (incluye las lineas
# -----BEGIN CERTIFICATE----- / -----END CERTIFICATE-----). Render admite valores
# multilinea en su editor de variables de entorno.
DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----

# --- Autenticacion ---
# JWT_SECRET y MFA_ENCRYPTION_KEY: generateValue: true en render.yaml -> Render los
# crea solos, no hace falta pegarlos aqui.
INITIAL_ADMIN_USERNAME=CajaHuancayo
# SECRETO de un solo uso para crear el primer administrador si la BD esta vacia.
INITIAL_ADMIN_PASSWORD=

# --- Red ---
# URL exacta del panel web desplegado (sin slash final).
FRONTEND_URL=https://caja-huancayo-web.onrender.com

# --- Evidencias ---
# EVIDENCIAS_DIR ya apunta al disco persistente montado por render.yaml (/var/data).
# EVIDENCIAS_BASE_URL se autocompleta con RENDER_EXTERNAL_URL; no hace falta tocarlo.
