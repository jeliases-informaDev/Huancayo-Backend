// Prisma 7 — La URL de conexión se gestiona desde prisma.config.ts

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TipoDocumento {
  DNI
  CE
  PASAPORTE
  RUC
}

enum TipoCredito {
  CONSUMO
  OTROS
}

/// Tabla física: usuarios (Administrador, Supervisor, Auditor)
/// Empresas (clientes de Sulotec: cajas, financieras, negocios). Cada fila de las demás tablas pertenece a una empresa y el servidor
/// filtra por ella en cada consulta (src/core/tenant). Los clientes no saben unos de otros: nadie elige empresa, la da su cuenta.
model Empresa {
  id_empresa     String   @id @default(uuid()) @db.VarChar(36)
  nombre         String   @db.VarChar(150)
  nombre_corto   String?  @db.VarChar(60)
  slug           String   @unique @db.VarChar(60) // identificador legible y estable (p. ej. caja-huancayo)
  estado         String   @default("ACTIVA") @db.VarChar(20) // ACTIVA, SUSPENDIDA
  // Reglas de la empresa (geocerca, precisión, autoasignación…) y su marca (nombre que ve el usuario, colores, logo): datos, no código.
  configuracion  Json?
  marca          Json?
  creado_en      DateTime @default(now())
  actualizado_en DateTime @default(now()) @updatedAt

  @@map("empresas")
}

model Usuario {
  id_usuario        String    @id @default(uuid()) @db.VarChar(36)
  empresa_id        String?   @db.VarChar(36) // nulo solo para el rol UNIVERSAL (administrador de Sulotec)
  username          String    @unique @db.VarChar(50)
  nombres           String?   @db.VarChar(150)
  apellidos         String?   @db.VarChar(200)
  email             String?   @db.VarChar(150)
  sede              String?   @db.VarChar(100)
  // Departamento donde opera el auditor de campo (ej. "Junín", "Lima"): se compara
  // contra expediente.departamento al asignar, para no mandarlo a visitar a otra
  // ciudad. Nulo = sin restricción geográfica configurada todavía.
  departamento      String?   @db.VarChar(100)
  password_hash     String    @db.Text
  rol               String    @db.VarChar(20) // ADMINISTRADOR, SUPERVISOR, AUDITOR
  estado            String    @default("ACTIVO") @db.VarChar(20) // ACTIVO, INACTIVO
  fecha_creacion    DateTime  @default(now())
  mfa_habilitado    Boolean   @default(false)
  mfa_requerido     Boolean   @default(false)
  mfa_exento        Boolean   @default(false)
  mfa_secreto       String?   @db.Text
  mfa_ultimo_uso    DateTime?
  token_version     Int       @default(0)
  intentos_fallidos Int       @default(0)
  bloqueado_hasta   DateTime?
  ultimo_acceso     DateTime?
  password_cambio   DateTime  @default(now())
  latitud           Decimal?  @db.Decimal(10, 8) // última ubicación conocida en campo (auditor/supervisor)
  longitud          Decimal?  @db.Decimal(11, 8)
  // Cuándo llegó esa última posición, con qué precisión y si venía de un GPS simulado: sin la hora no se puede
  // distinguir una posición de hace 5 segundos de una de hace 3 días.
  ubicacion_en        DateTime?
  ubicacion_precision Decimal?  @db.Decimal(8, 2)
  ubicacion_simulada  Boolean   @default(false)
  // Estado del celular en la última posición: con la batería se distingue «no se mueve» de «se quedó sin batería».
  bateria_porcentaje  Int?
  bateria_cargando    Boolean   @default(false)
  // Cómo se mueve (a pie, vehículo, detenido…): se calcula al recibir cada posición y se guarda aquí, así la lista en vivo no
  // tiene que releer los puntos GPS de todos los auditores en cada refresco.
  mov_estado          String?   @db.VarChar(15)
  mov_desde           DateTime?
  mov_velocidad       Decimal?  @db.Decimal(6, 1)
  mov_modo            String?   @db.VarChar(12)
  // Jornada de campo: el auditor la inicia y la termina desde la app; solo durante ella la app comparte su ubicación
  // aunque la pantalla esté apagada. En jornada = jornada_inicio con jornada_fin vacío o anterior al inicio.
  jornada_inicio      DateTime?
  jornada_fin         DateTime?

  asignaciones AsignacionAuditoria[]
  visitas      VisitaAuditoria[]
  dispositivos DispositivoAutorizado[]
  trackings    TrackingUbicacion[]
  eventosCampo EventoCampo[]

  @@index([empresa_id, rol])
  @@map("usuarios")
}

/// Historial de posiciones GPS del personal de campo (Supervisor/Auditor) — permite
/// reconstruir la ruta recorrida en el mapa de supervisión (Fase 2/Fase 6 del flujo).
model TrackingUbicacion {
  id_tracking      BigInt   @id @default(autoincrement())
  empresa_id       String   @db.VarChar(36)
  id_usuario       String   @db.VarChar(36)
  latitud          Decimal  @db.Decimal(10, 8)
  longitud         Decimal  @db.Decimal(11, 8)
  precision_metros Decimal? @db.Decimal(8, 2)
  simulada         Boolean  @default(false) // el celular avisó que la posición venía de un GPS simulado
  registrado_en    DateTime @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)

  @@index([id_usuario, registrado_en])
  @@index([registrado_en]) // depuración de puntos antiguos
  @@index([empresa_id])
  @@map("tracking_ubicacion")
}

/// Avisos de llegada y salida: el auditor entró a la geocerca de un punto de un caso (domicilio o negocio) o se alejó de ella.
/// Los calcula el servidor con cada posición en vivo; una posición simulada o muy imprecisa no genera avisos.
model EventoCampo {
  id_evento     BigInt   @id @default(autoincrement())
  empresa_id    String   @db.VarChar(36)
  id_usuario    String   @db.VarChar(36)
  id_expediente Int
  punto         String   @db.VarChar(20) // DOMICILIO o NEGOCIO:n
  tipo          String   @db.VarChar(10) // LLEGADA, SALIDA
  distancia_m   Decimal? @db.Decimal(8, 2)
  latitud       Decimal  @db.Decimal(10, 8)
  longitud      Decimal  @db.Decimal(11, 8)
  registrado_en DateTime @default(now())

  usuario    Usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  expediente Expediente @relation(fields: [id_expediente], references: [id_expediente], onDelete: Restrict, onUpdate: Cascade)

  @@index([id_usuario, registrado_en])
  @@index([id_expediente])
  @@index([empresa_id, registrado_en])
  @@map("eventos_campo")
}

/// Ajustes que un administrador cambia desde el panel (clave/valor). Hoy: autoasignacion (que el auditor pueda tomar casos por su cuenta).
/// Si una clave no existe se usa el valor por defecto de la configuración del servidor.
model ConfiguracionSistema {
  empresa_id      String   @db.VarChar(36)
  clave           String   @db.VarChar(60)
  valor           String   @db.VarChar(200)
  actualizado_por String?  @db.VarChar(36)
  actualizado_en  DateTime @default(now()) @updatedAt

  @@id([empresa_id, clave])
  @@map("configuracion_sistema")
}

/// Tabla física: dispositivos_autorizados — vincula un usuario a los dispositivos desde los que ha iniciado sesión
model DispositivoAutorizado {
  id_dispositivo     String    @id @default(uuid()) @db.VarChar(36)
  empresa_id         String    @db.VarChar(36)
  id_usuario         String    @db.VarChar(36)
  device_id          String    @db.VarChar(150) // identificador estable del dispositivo (installationId)
  nombre_dispositivo String?   @db.VarChar(150)
  activo             Boolean   @default(true)
  primer_uso         DateTime  @default(now())
  ultimo_uso         DateTime?

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id_usuario, device_id])
  @@index([id_usuario])
  @@index([empresa_id])
  @@map("dispositivos_autorizados")
}

/// Tabla física: expedientes — ficha de crédito/cliente a auditar, prellenada por importación
model Expediente {
  id_expediente     Int         @id @default(autoincrement())
  empresa_id        String      @db.VarChar(36)
  codigo_expediente String      @db.VarChar(50) // N° de crédito / clave de importación (único dentro de cada empresa)
  tipo_credito      TipoCredito @default(CONSUMO)
  oficina           String?     @db.VarChar(100)

  tipo_documento_cliente   TipoDocumento @default(DNI)
  numero_documento_cliente String        @db.VarChar(20)
  nombres_cliente          String        @db.VarChar(200)
  telefono_cliente         String?       @db.VarChar(20)
  direccion_domicilio      String?       @db.VarChar(255)
  distrito                 String?       @db.VarChar(100)
  provincia                String?       @db.VarChar(100)
  departamento             String?       @db.VarChar(100)
  latitud                  Decimal?      @db.Decimal(10, 8) // domicilio del cliente — base para el chequeo de geocerca
  longitud                 Decimal?      @db.Decimal(11, 8)

  asesor_responsable String   @db.VarChar(150)
  monto_desembolso   Decimal? @db.Decimal(12, 2)
  moneda             String?  @db.VarChar(5)

  // Bloques variables de la ficha (ver PLANTILLAS FICHAS DE VISITA): se guardan como JSON
  // para no sobre-normalizar ~80 campos que la app solo muestra de referencia al auditor.
  datos_cliente         Json? // identidad/domicilio adicionales (fuente, fecha nac., edad, estado civil, vivienda...)
  datos_negocio         Json? // actividad, antigüedad, empleador/negocio, tipo de cliente...
  datos_credito         Json? // historial crediticio + datos del crédito y participantes
  evaluacion_financiera Json? // ingresos / balance general / estado de resultados (variante Otros)
  endeudamiento         Json? // tabla de endeudamiento del cliente y cónyuge

  // --- Dirección y geocodificación (ver src/modules/geocodificacion) ---
  // Dirección del domicilio ya normalizada (Av. → Avenida…) y separada en sus partes (tipo de vía, nombre, número, manzana/lote,
  // urbanización, interior, referencia) con las señales de calidad que le faltan para ubicarla con precisión.
  direccion_normalizada String?  @db.VarChar(300)
  direccion_componentes Json?
  // Ubicación SUGERIDA por un proveedor de mapas (no es la referencia de la geocerca hasta que sea de confianza alta o la acepte una persona):
  // PENDIENTE | LOCALIZADO | REVISAR | NO_ENCONTRADO | ERROR | VERIFICADO (la aceptó una persona o se confirmó en campo).
  geo_estado    String?  @db.VarChar(15)
  geo_confianza String?  @db.VarChar(10) // ALTA | MEDIA | BAJA
  geo_precision String?  @db.VarChar(12) // EXACTA | APROXIMADA | DISTRITO
  geo_proveedor String?  @db.VarChar(12)
  geo_latitud   Decimal? @db.Decimal(10, 8)
  geo_longitud  Decimal? @db.Decimal(11, 8)
  geo_direccion_encontrada String? @db.VarChar(400)
  geo_fecha     DateTime?

  // --- Trazabilidad del dato ---
  // De dónde salió la ubicación del domicilio: REFERENCIA (coordenadas escritas en la referencia de la base), MANUAL (la fijó un
  // supervisor/admin en el panel), PRIMERA_VISITA (la tomó el auditor al visitar) o GEOCODIFICADA (un proveedor de mapas con confianza
  // alta). Nulo = sin ubicación todavía.
  ubicacion_origen String? @db.VarChar(20)
  // false = solo un supervisor/admin puede asignarlo; true = además los auditores de su zona pueden
  // tomarlo por su cuenta ("Disponibles en tu zona"). Las cargas masivas lo dejan en false por defecto.
  autoasignable Boolean @default(true)
  // Importación que creó/actualizó por última vez este expediente, fila del archivo y
  // huella (SHA-256) de la fila normalizada: permite detectar "sin cambios" al reimportar.
  id_importacion String? @db.VarChar(36)
  fila_origen    Int?
  hash_origen    String? @db.VarChar(64)
  // Avisos de calidad del dato detectados al importar (texto dañado, sin coordenadas...).
  advertencias_origen Json?

  estado           String   @default("PENDIENTE") @db.VarChar(20) // PENDIENTE, ASIGNADO, VISITADO, CERRADO
  fecha_creacion   DateTime @default(now())
  fecha_actualizar DateTime @updatedAt

  asignaciones AsignacionAuditoria[]
  visitas      VisitaAuditoria[]
  cambios      ExpedienteCambio[]
  eventosCampo EventoCampo[]

  @@index([latitud, longitud])
  @@index([distrito])
  @@index([departamento])
  @@index([geo_estado])
  @@unique([empresa_id, codigo_expediente])
  @@index([empresa_id, estado])
  @@index([empresa_id, estado, autoasignable, departamento, fecha_creacion], map: "expedientes_disponibles_idx") // lista «Disponibles» paginada
  @@index([asesor_responsable])
  @@index([id_importacion])
  @@map("expedientes")
}

/// Historial de cambios de datos de un expediente (reimportaciones y ediciones de ubicación):
/// qué campo cambió, de qué valor a cuál, cuándo y por qué importación/usuario.
model ExpedienteCambio {
  id_cambio      BigInt   @id @default(autoincrement())
  empresa_id     String   @db.VarChar(36)
  id_expediente  Int
  id_importacion String?  @db.VarChar(36)
  actor_id       String?  @db.VarChar(36)
  tipo           String   @db.VarChar(20) // CREADO, ACTUALIZADO, UBICACION
  cambios        Json
  fecha          DateTime @default(now())

  expediente Expediente @relation(fields: [id_expediente], references: [id_expediente], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_expediente, fecha])
  @@index([id_importacion])
  @@index([empresa_id])
  @@map("expediente_cambios")
}

/// Tabla física: asignaciones_auditoria — auditor ↔ expediente (muestra a visitar)
model AsignacionAuditoria {
  id_asignacion      Int       @id @default(autoincrement())
  empresa_id         String    @db.VarChar(36)
  id_expediente      Int
  id_usuario_auditor String    @db.VarChar(36)
  fecha_asignacion   DateTime  @default(now())
  fecha_fin          DateTime?
  estado             String    @default("ACTIVA") @db.VarChar(20) // ACTIVA, FINALIZADA, CANCELADA
  prioridad          String    @default("MEDIA") @db.VarChar(20) // ALTA, MEDIA, BAJA
  // Quién y cómo se creó: SUPERVISOR (asignada por un supervisor/admin, asignado_por = su id)
  // o AUTOASIGNADA (el propio auditor la tomó).
  origen             String    @default("SUPERVISOR") @db.VarChar(20)
  asignado_por       String?   @db.VarChar(36)

  expediente Expediente @relation(fields: [id_expediente], references: [id_expediente], onDelete: Restrict, onUpdate: Cascade)
  auditor    Usuario    @relation(fields: [id_usuario_auditor], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)

  @@index([id_usuario_auditor])
  @@index([id_expediente])
  @@index([empresa_id, estado, id_usuario_auditor]) // «mi muestra», carga por auditor y mapa del supervisor
  @@map("asignaciones_auditoria")
}

/// Tabla física: visitas_auditoria — ejecución real de la ficha de entrevista en campo
model VisitaAuditoria {
  id_visita          Int       @id @default(autoincrement())
  empresa_id         String    @db.VarChar(36)
  client_sync_id     String?   @unique @db.VarChar(100) // idempotencia para visitas creadas sin conexión
  id_asignacion      Int?
  id_expediente      Int
  id_usuario_auditor String    @db.VarChar(36)

  fecha_hora_checkin  DateTime
  fecha_hora_checkout DateTime?
  latitud             Decimal   @db.Decimal(10, 8)
  longitud            Decimal   @db.Decimal(11, 8)
  precision_metros    Decimal?  @db.Decimal(8, 2) // precisión GPS reportada por el dispositivo

  // Señales anti-fraude calculadas/recibidas al momento de la visita
  distancia_domicilio_m Decimal? @db.Decimal(10, 2) // distancia Haversine al punto visitado (domicilio, o negocio en MYPE)
  ubicacion_visitada    String?  @db.VarChar(10) // DOMICILIO | NEGOCIO: a qué dirección fue el auditor (MYPE puede ir a cualquiera de las dos)
  direccion_visitada    String?  @db.VarChar(255) // texto de esa dirección tal como estaba en la base
  mock_location         Boolean  @default(false) // ubicación simulada detectada (Fake GPS)
  device_integrity_ok   Boolean  @default(true) // sin indicios de root/jailbreak/emulador
  device_id             String?  @db.VarChar(150)
  server_received_at    DateTime @default(now()) // hora del servidor, no confiar solo en la del dispositivo

  resultado                String  @db.VarChar(30) // CONFORME, OBSERVADO, NO_UBICADO, RECHAZADO
  respuestas_cuestionario Json // preguntas SI/NO de la ficha (cuestionario al cliente)
  comentario_negocio      String? @db.Text
  comentario_auditor      String? @db.Text
  otros_clientes_domicilio Json?
  otros_ingresos           Json?
  firma_evidencia          String? @db.Text // firma PNG en data URL

  // Ficha por tipo de crédito. "plantilla" identifica con qué formulario se tomó la visita
  // (CONSUMO_V1 / MYPE_V1) y "expediente_snapshot" congela los datos de la base tal como los
  // vio el auditor: si el expediente se reimporta después, la ficha ya cerrada no cambia.
  plantilla              String? @db.VarChar(20)
  expediente_snapshot    Json?
  estado_negocio         String? @db.VarChar(30) // EN_FUNCIONAMIENTO, INOPERATIVO, DE_TERCEROS (solo MYPE)
  propiedad_local        String? @db.VarChar(30) // PROPIO, ALQUILADO, FAMILIAR, OTRO (solo MYPE)
  otros_pasivos          String? @db.VarChar(500)
  conformidad_financiera Json? // análisis/conformidad del auditor por bloque (ingresos, balance, resultados)
  firmante_documento     String? @db.VarChar(20) // N° de documento de quien firmó

  estado           String   @default("ABIERTA") @db.VarChar(20) // ABIERTA, CERRADA
  fecha_creacion   DateTime @default(now())
  fecha_actualizar DateTime @updatedAt

  expediente Expediente  @relation(fields: [id_expediente], references: [id_expediente], onDelete: Restrict, onUpdate: Cascade)
  auditor    Usuario     @relation(fields: [id_usuario_auditor], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  evidencias Evidencia[]

  @@index([id_expediente])
  @@index([id_usuario_auditor, fecha_hora_checkin])
  @@index([empresa_id, fecha_creacion])
  @@map("visitas_auditoria")
}

/// Tabla física: evidencias — fotografías/documentos de una visita
model Evidencia {
  id_evidencia     String   @id @default(uuid()) @db.VarChar(36)
  empresa_id       String   @db.VarChar(36)
  id_visita        Int
  tipo             String   @db.VarChar(20) // FOTO_PRINCIPAL, FOTO_ADICIONAL
  object_key       String   @db.VarChar(255)
  hash_sha256      String   @db.VarChar(64) // detecta reuso de la misma foto entre visitas/clientes (dentro de la empresa)
  latitud_captura  Decimal? @db.Decimal(10, 8)
  longitud_captura Decimal? @db.Decimal(11, 8)
  capturado_en     DateTime
  fecha_creacion   DateTime @default(now())

  visita VisitaAuditoria @relation(fields: [id_visita], references: [id_visita], onDelete: Restrict, onUpdate: Cascade)

  @@unique([empresa_id, hash_sha256])
  @@index([id_visita])
  @@map("evidencias")
}

/// Registro inmutable de auditoría de seguridad (acceso y operaciones)
model AuditoriaSeguridad {
  id_auditoria  String   @id @default(uuid()) @db.VarChar(36)
  empresa_id    String?  @db.VarChar(36)
  fecha         DateTime @default(now())
  request_id    String?  @db.VarChar(100)
  actor_id      String?  @db.VarChar(36)
  actor         String?  @db.VarChar(50)
  rol           String?  @db.VarChar(30)
  metodo        String   @db.VarChar(10)
  ruta          String   @db.VarChar(255)
  estado_http   Int
  ip_address    String?  @db.VarChar(45)
  ip_hash       String?  @db.VarChar(64)
  user_agent    String?  @db.VarChar(255)
  device_id     String?  @db.VarChar(150)
  mock_location Boolean?

  // Diff de negocio (opcional): qué entidad cambió y su estado antes/después. Lo
  // llena el controlador vía req.auditContext cuando la operación lo amerita (no
  // todas: un GET o un login no tienen "entidad" que diffear). Nunca debe contener
  // secretos (password_hash, mfa_secreto) — cada servicio arma un snapshot sin eso.
  entidad        String? @db.VarChar(50)
  entidad_id     String? @db.VarChar(64)
  valor_anterior Json?
  valor_nuevo    Json?

  @@index([fecha])
  @@index([actor_id, fecha])
  @@index([empresa_id, fecha])
  @@map("auditoria_seguridad")
}

/// Importación masiva de expedientes por Excel (no hay integración en vivo con Caja Huancayo todavía)
model ImportacionMasiva {
  id_importacion String    @id @default(uuid()) @db.VarChar(36)
  empresa_id     String    @db.VarChar(36)
  tipo           String    @db.VarChar(30)
  estado         String    @default("PENDIENTE") @db.VarChar(20)
  archivo        String    @db.VarChar(255)
  ruta_temporal  String    @db.Text
  actor_id       String?   @db.VarChar(36)
  total_filas    Int       @default(0)
  procesadas     Int       @default(0)
  insertadas     Int       @default(0)
  actualizadas   Int       @default(0)
  omitidas       Int       @default(0)
  errores        Int       @default(0)
  detalle_error  Json?
  // Trazabilidad del archivo: huella SHA-256 (el mismo archivo no se procesa dos veces sin
  // que se note), formato detectado y resumen de avisos de calidad del dato.
  archivo_sha256 String?   @db.VarChar(64)
  formato        String?   @db.VarChar(20)
  advertencias   Json?
  fecha_creacion DateTime  @default(now())
  fecha_inicio   DateTime?
  fecha_fin      DateTime?

  @@index([estado, fecha_creacion])
  @@index([actor_id, fecha_creacion])
  @@index([empresa_id, fecha_creacion])
  @@map("importaciones_masivas")
}
