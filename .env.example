# Caja Huancayo - Auditoria de Visitas (Backend)
# Plantilla local de desarrollo. Nunca confirme un .env real con secretos.

# Infraestructura
NODE_ENV=development
PORT=4100
# MySQL local (ver docker-compose.yml -> "docker compose up -d").
DATABASE_URL=mysql://caja_huancayo:caja_huancayo_dev@localhost:3306/caja_huancayo_auditoria

# Criptografia y autenticacion
# SECRETOS: aleatorios, diferentes entre si y con 32 caracteres como minimo.
JWT_SECRET=
MFA_ENCRYPTION_KEY=
# Usuario/clave de un solo uso para crear el primer administrador si la BD esta vacia.
INITIAL_ADMIN_USERNAME=CajaHuancayo
INITIAL_ADMIN_PASSWORD=
RESET_INITIAL_ADMIN=false
REQUIRE_MFA=false
MFA_EXEMPT_USERNAMES=CajaHuancayo
JWT_EXPIRES_IN=8h
JWT_FIELD_EXPIRES_IN=12h
JWT_ISSUER=caja-huancayo-auditoria-api
JWT_AUDIENCE=caja-huancayo-auditoria-clients
MAX_LOGIN_FAILURES=5
ACCOUNT_LOCK_MINUTES=15
# Un dispositivo activo por cuenta de campo. Default "true" (incluida produccion).
# Poner "false" solo en desarrollo local si vas a re-loguear el mismo usuario de
# prueba seguido desde distintos navegadores/dispositivos.
ENFORCE_DEVICE_BINDING=true

# Red y navegador
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ALL=true
TRUST_PROXY=false

# Observabilidad: fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info

# Evidencias (fase 1: disco local del servidor, sin credenciales cloud).
EVIDENCIAS_DIR=./storage/evidencias
# Destino de las fotos: local (disco) o s3 (bucket compatible con S3, p. ej. Oracle Object Storage: endpoint https://<namespace>.compat.objectstorage.<region>.oraclecloud.com).
EVIDENCIAS_BACKEND=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
EVIDENCIAS_BASE_URL=http://localhost:4100

# Anti-fraude: geocerca entre el domicilio del expediente y el punto real de la visita.
GEOFENCE_RADIO_METROS=100
GEOFENCE_PRECISION_MAXIMA_METROS=100

# Anti-fraude: «Disponibles / Tomar este caso». false = el auditor solo trabaja los casos que le asigna un supervisor.
PERMITIR_AUTOASIGNACION=true

# Multiempresa: primera empresa (se crea si no hay ninguna) y, opcionalmente, el administrador universal de Sulotec (sin empresa).
EMPRESA_INICIAL_NOMBRE=Caja Huancayo
INITIAL_UNIVERSAL_USERNAME=
INITIAL_UNIVERSAL_PASSWORD=

# Días que se conservan los puntos GPS del recorrido (tracking_ubicacion). 0 = no depurar.
TRACKING_RETENCION_DIAS=90

# Direcciones en el mapa (ver GEOCODIFICACION.md). Apagado por defecto: enviar direcciones de clientes a un proveedor externo
# de mapas requiere la autorización del banco.
GEOCODING_WORKER_ENABLED=false
GEOCODING_PROVIDER=nominatim
# MAPBOX_ACCESS_TOKEN=
